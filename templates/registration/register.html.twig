{% extends 'base.html.twig' %}

{% block title %}S'enrégistrer{% endblock %}

{% block body %}
{% import 'macros/form_macros.html.twig' as formMacros %}

<form class="flex rounded-[30px] mx-auto p-5 flex-col items-center gap-5  bg-white text-black w-[600px] my-4" method="POST" action="">
    <h1 class=" mx-auto  text-center text-4xl font-bold font-['Quicksand'] tracking-widest">Formulaire d'inscription</h1>
    {{ form_errors(registrationForm) }}

    {{ form_start(registrationForm) }}
    
    {{ formMacros.render_field(registrationForm.nom) }}
    {{ formMacros.render_field(registrationForm.prenom) }}
    {{ formMacros.render_field(registrationForm.email) }}
    {{ formMacros.render_field(registrationForm.password) }}
    {{ formMacros.render_field(registrationForm.roles) }}
    {{ formMacros.render_field(registrationForm.classe) }}
        <button class="w-[300px] h-[62px]  text-white bg-[#07244b] rounded-[10px] shadow-[4px_4px_60px_0px_rgba(0,0,0,0.25)] justify-center items-center gap-2.5 inline-flex text-white  font-bold font-['Quicksand'] tracking-wide" type="submit">Soumettre mon inscription</button>
        <span class="text-black text-[32px] font-medium font-['Quicksand'] tracking-tight">Avez-vous déjà un compte? 
            <a href="{{ path('app_login')}}" class="text-[#fa58b6] cursor-pointer text-[32px] font-lg font-['Quicksand']  tracking-tight">Se connecter</a>
        </span>
    {{ form_end(registrationForm) }}
</form>
{% endblock %}
