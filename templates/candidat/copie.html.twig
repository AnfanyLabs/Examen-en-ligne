{% extends 'authenticatebase.html.twig' %}

{% block title %}DigitalExam~créer des questions{% endblock %}

{% block authenticatebody %}
{% import 'macros/form_macros.html.twig' as formMacros %}

 <main class="container">
    <div class="flex items-center justify-center text-center my-4 p-4 border-t-4 border-gray-300 bg-white dark:bg-gray-800 dark:border-gray-600" role="alert">
        <div class="ms-3 text-2xl font-medium text-gray-800 dark:text-gray-300">
            COPIE DU CANDIDAT
        </div>
    </div>
    <div class="grid grid-cols md:grid-cols lg:grid-cols">
        <div class="sm:first:col py-6 px-11  bg-white text-black rounded-lg w-auto">
            <h4 class="mb-4 text-black text-[16px] uppercase text-center sm:text-[25px] font-extrabold leading-none">
                <span>{{ epreuve.nom}} </span>
            </h4>
            <div class="mb-4 text-black text-[16px]  text-center sm:text-[15px] font-extrabold leading-none">
                <span>Matière:{{ epreuve.discipline.nom}} </span>
            </div>
            <div class="mb-4 text-black text-[16px]  text-center sm:text-[15px] font-extrabold leading-none">
                <span>Coefficient:0{{ epreuve.coefficient}} </span>
            </div>
            <div class="mb-4 text-black text-[16px]  text-center sm:text-[15px] font-extrabold leading-none">
                <span>Durée:{{ epreuve.dureeEpreuve}} min</span>
            </div>
            <div class="mb-4 text-black text-[16px]  text-center sm:text-[15px] font-extrabold leading-none">
                <span>Classe:{{ epreuve.classe.nom}} </span>
            </div>
            <div class="text-lg text-black  border-t border-black border-solid leading-[1.8]">
            <p class="font-extrabold italic underline">Contexte d'évaluation:</p>  
            <p>{{epreuve.contexte}}</p>
            </div>
            <div class="font-extrabold italic">
            <p class="underline">Tâche: </p> Tu es invité(é) à relever les défis soulevés par la situation-contexte ci-dessus. Pour cela, réponds à la consigne suivante: 
            </div>
           <div class="w-full p-2">
                <h1 class="font-extrabold italic underline">Consigne</h1>



            <div class="flex flex-wrap">
                {% for question in epreuve.questions %}
                <div class="w-full mt-1">
                    <div class="bg-gray-100 mt-1 rounded flex p-4 h-full items-center">
                        <span class="text-4xl font-bold mx-4">{{ loop.index}}.</span>
                        <span class="font-medium">
                          {{ question.contenu}}  
                        </span>                            
                    </div>
                </div>
                {% if question.reponse is not null %}
                    
                <div class="bg-blue-200 w-full border-blue-600 text-blue-600  border-l-4 p-4" role="alert">
                    <p class="font-bold">
                        Réponse:
                    </p>
                     <p>
                        {{ question.reponse.contenu }}
                    </p>
                </div>
                {% endif %}
                {% endfor %}
            </div>
            {% if is_granted('ROLE_ADMIN') %}
               <div class="px-6 py-4 border-r border-blue-400 text-center">
                    <div class="p-2">
                        <button class="px-2 py-1 font-medium text-white bg-blue-600 rounded-md hover:bg-blue-500 focus:outline-none focus:shadow-outline-blue active:bg-blue-600 transition duration-150 ease-in-out">
                            <a href="">
                                Editer l'épreuve
                            </a>
                        </button>
                        <button class="mt-2 px-2 py-1 font-medium text-white bg-red-600 rounded-md hover:bg-red-500 focus:outline-none focus:shadow-outline-red active:bg-red-600 transition duration-150 ease-in-out">
                            <a href="">
                                 Supprimer l'épreuve
                            </a> 
                        </button>
                        <button class="inline-block px-7 py-1.5 overflow-hidden text-sm font-semibold transition-transform rounded-full group text text-green-700/70 bg-green-500/70 hover:text-white">
                                <a href="{{ path('admin_epreuve_toggle_isPublished', { id: epreuve.id }) }}" class="flex items-center space-x-4 no-underline text-white">
                                        {{ epreuve.isPublished ? "Annuler l'épreuve " : " valider l'épreuve" }}
                                    <div class="relative w-10 h-5">
                                        <div class="absolute inset-0 bg-gray-300 dark:bg-gray-600 rounded-full transition peer-checked:bg-red-600"></div>
                                        <div class="absolute top-0.5 left-0.5 bg-white w-4 h-4 rounded-full shadow-md transition-transform duration-300 transform 
                                            {{ epreuve.isPublished ? 'translate-x-5' : '' }}">
                                        </div>
                                    </div>
                                </a>    
                        </button>
                    </div>
                </div>
            {% endif %}
            <div class="w-full">
                {{ form_start(form) }}
                    {{ formMacros.render_field(form.question) }}
            <h1 class="font-extrabold ml-4 mt-[50px] mb-0"> Ajouter une réponse:</h1>
                    {{ formMacros.render_field(form.contenu) }}
                    <button type="submit" class="px-6 mt-2 py-2 bg-[#07244b] text-white font-semibold rounded-md hover:bg-indigo-600 focus:outline-none">Répondre</button>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</main>
{% endblock %}