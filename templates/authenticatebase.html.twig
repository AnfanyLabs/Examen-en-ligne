{% extends 'base.html.twig' %}

{% block title %}Espace Candidat {% endblock %}

{% block body %}

 {% set roleLabels = {
    'ROLE_ADMIN': 'Administrateur',
    'ROLE_CANDIDAT': 'Candidat',
    'ROLE_ENSEIGNANT': 'Enseignant'
} %}


    <!-- Barre d’en-tête centrée -->
<header class=" fixed grid grid-cols-3 z-40 items-center w-full px-4 py-2 bg-white shadow dark:bg-gray-800">
  <!-- Colonne 1 : bouton burger -->
  <div class="flex items-center">
    <button data-drawer-target="logo-sidebar"
            data-drawer-toggle="logo-sidebar"
            aria-controls="logo-sidebar"
            type="button"
            class="inline-flex items-center p-2 text-sm text-gray-500 rounded-lg hover:bg-gray-100
                   focus:outline-none focus:ring-2 focus:ring-gray-200 dark:text-gray-400
                   dark:hover:bg-gray-700 dark:focus:ring-gray-600">
      <span class="sr-only">Open sidebar</span>
      <svg class="w-6 h-6" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20">
        <path clip-rule="evenodd" fill-rule="evenodd"
              d="M2 4.75A.75.75 0 012.75 4h14.5a.75.75 0 010 1.5H2.75A.75.75 0 012 4.75zm0 10.5a.75.75 0 01.75-.75h7.5a.75.75 0 010 1.5h-7.5a.75.75 0 01-.75-.75zM2 10a.75.75 0 01.75-.75h14.5a.75.75 0 010 1.5H2.75A.75.75 0 012 10z">
        </path>
      </svg>
    </button>
  </div>

  <!-- Colonne 2 : titre centré -->
  <h1 class="justify-self-center z-40 text-center text-xl font-semibold sm:text-2xl whitespace-nowrap
             text-gray-900 dark:text-white">
    ESPACE DE CANDIDAT
  </h1>

  <!-- Colonne 3 : menu utilisateur aligné à droite -->
  <div class="flex justify-end items-center">
    <button type="button"
            class="flex text-sm bg-gray-800 rounded-full focus:ring-4 focus:ring-gray-300
                   dark:focus:ring-gray-600"
            aria-expanded="false"
            data-dropdown-toggle="dropdown-user">
      <span class="sr-only">Open user menu</span>
      <img class="w-8 h-8 rounded-full"
           src="https://flowbite.com/docs/images/people/profile-picture-5.jpg"
           alt="user photo">
    </button>

    <!-- Dropdown -->
    <div id="dropdown-user"
         class="z-50 hidden my-4 text-base list-none bg-white divide-y divide-gray-100
                rounded-sm shadow-sm dark:bg-gray-700 dark:divide-gray-600">
      <div class="px-4 py-3">
        <p class="text-sm text-gray-900 dark:text-white">Neil Sims</p>
        <p class="text-sm font-medium text-gray-900 truncate dark:text-gray-300">
          neil.sims@flowbite.com
        </p>
      </div>
      <ul class="py-1">
        <li>
          <a href="#"
             class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100
                    dark:text-gray-300 dark:hover:bg-gray-600 dark:hover:text-white">
            Paramètres
          </a>
        </li>
        <li>
          <a href="#"
             class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100
                    dark:text-gray-300 dark:hover:bg-gray-600 dark:hover:text-white">
            Se déconnecter
          </a>
        </li>
      </ul>
    </div>
  </div>
</header>


