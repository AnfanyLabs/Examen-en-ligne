{# templates/macros/form_macros.html.twig #}
{% macro render_field(field, labelClass, inputClass) %}
    <div class="flex flex-col  gap-1 m-4 w-full">
        {{ form_label(field, null, {'label_attr': {'class': labelClass|default('absolute left-3 -top-6 bg-transparent text-xl leading-7 text-white transition-all peer-placeholder-shown:left-3 peer-placeholder-shown:top-2 peer-placeholder-shown:bg-gray-900 peer-placeholder-shown:text-base peer-placeholder-shown:text-gray-500 peer-focus:left-3 peer-focus:-top-6 peer-focus:text-sm peer-focus:text-indigo-500')}}) }}
        {{ form_widget(field, {
            'attr': {
                'class': (inputClass|default('bg-gray-200 text-black rounded h-20 pl-12 py-2 md:py-4 focus:outline-none w-full')) ~ ' ' ~ (field.vars.errors|length > 0 ? 'border-red-500' : '')
            }
        }) }}
        {{ form_errors(field, {'attr': {'class': 'text-red-500 text-sm'}}) }}
    </div>
{% endmacro %}
